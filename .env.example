# 後端 API 根路徑（未設定時，前端使用 src/api/data 內建靜態資料）
VITE_API_BASE_URL=

# 網站正式網址（產生 sitemap.xml、canonical 與社群分享網址用，結尾不要加 /）
VITE_SITE_URL=https://www.example.com.tw

# 原站檔案（申請書、收費文件、公告圖片）的根網址；檔案搬家時改這裡
VITE_LEGACY_SITE_URL=https://agama-bt.com.tw

# 未接後端時是否開放「示範」登入／註冊（npm run dev 時一律開放；正式環境請保持 false）
VITE_DEMO_MEMBER=false

# 設為 true 時整站不讓搜尋引擎收錄（給客戶預覽時用）。未設定 VITE_SITE_URL 時也會自動不收錄
VITE_NOINDEX=false
